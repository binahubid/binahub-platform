{
  "name": "binahub-platform",
  "version": "0.11.5",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\"",
    "test:smoke": "node scripts/ams-production-smoke.mjs",
    "test:cv": "node scripts/ams-cv-workflow-smoke.mjs",
    "test:cv-admin": "node scripts/ams-admin-cv-enrichment-smoke.mjs",
    "test:ai-router": "node scripts/ai-cv-router-self-test.mjs",
    "test:ai-managed": "node scripts/ai-managed-router-self-test.mjs",
    "test:ai:privacy": "node --test scripts/ai-data-privacy-self-test.mjs",
    "test:status": "node --experimental-strip-types --test scripts/status-health.contract.mjs",
    "test:pdf": "node --test scripts/cv-print.contract.mjs",
    "test:validation": "pnpm --filter @ams/shared build && pnpm --filter @ams/validation build && node --test scripts/validation-contract.test.mjs",
    "test:dependencies": "node --test tools/dependency-contract.test.mjs",
    "test:api:contract": "node --test scripts/api-contract.test.mjs",
    "admin:cv-enrich": "node scripts/ams-cv-enrichment-interactive.mjs",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @ams/database db:generate",
    "db:push": "pnpm --filter @ams/database db:push",
    "db:seed": "pnpm --filter @ams/database db:seed"
  },
  "devDependencies": {
    "minimatch": "11.0.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.28",
    "@types/node": "^26.1.0",
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "openai": "^6.42.0",
    "pdf-parse": "^1.1.1"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.28",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "minimatch": "11.0.1",
      "esbuild": "0.28.1",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.0",
      "postcss-selector-parser@>=6 <7": "6.1.5"
    }
  }
}
