{
  "name": "@ams/api",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @ams/shared build && pnpm --filter @ams/ai build && tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@ams/ai": "workspace:*",
    "@ams/config": "workspace:*",
    "@ams/database": "workspace:*",
    "@ams/domain": "workspace:*",
    "@ams/shared": "workspace:*",
    "@ams/validation": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.14",
    "openai": "^6.42.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
