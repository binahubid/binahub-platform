# ============================================
# AMS API Environment Variables
# ============================================

# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI routing for CV parsing. LapakVIP is primary; OpenRouter is fallback.
# DeepSeek 3.2 is sufficient for text-based structured CV extraction without
# paying for a vision or frontier reasoning model.
LAPAKVIP_API_KEY=
LAPAKVIP_BASE_URL=https://router.lapakvip.com/api/v1
LAPAKVIP_MODEL=lv/deepseek-3.2
LAPAKVIP_FALLBACK_MODELS=
LAPAKVIP_JSON_MODE_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
AI_REQUEST_TIMEOUT_MS=25000
AI_TOTAL_TIMEOUT_MS=55000
AI_MAX_TOKENS=12000
AI_JSON_MODE_ENABLED=true

# Backward-compatible OpenAI-compatible gateway configuration. Existing AMS
# deployments may keep this while migrating the OpenRouter key names above.
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=qwen/qwen3.8-27b:free
OPENAI_FALLBACK_MODELS=google/gemma-4-31b-it:free

# Sentry (for error tracking)
SENTRY_DSN=

# Meilisearch (for search)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=
